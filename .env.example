# ─── Database (Vercel Postgres / Neon) ───────────────────────────────
# Pooled connection string used by Prisma at runtime
POSTGRES_PRISMA_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct (non-pooling) connection string used for migrations
POSTGRES_URL_NON_POOLING="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-char-string"

# ─── Vercel Blob (success-case image uploads) ────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# ─── Admin seed credentials (used by prisma/seed.ts) ─────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="weflow1234"

# ─── Feature flags ───────────────────────────────────────────────────
POLLING_INTERVAL="5000"
